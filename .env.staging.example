# ==============================================================================
# OUTVIER STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================
NODE_ENV=staging
PORT=5000
FRONTEND_URL=https://staging.outvier.com

# Database Connection (Isolated Staging Database)
MONGO_URI=mongodb://outvier_staging:STAGING_SECRET_PASSWORD@127.0.0.1:27017/outvier_staging?authSource=admin
MONGO_ROOT_USER=outvier_staging
MONGO_ROOT_PASSWORD=STAGING_SECRET_PASSWORD

# Redis Staging Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=STAGING_REDIS_PASSWORD

# Security Secrets (Distinct from Production)
JWT_SECRET=STAGING_64_CHAR_HEX_RANDOM_SECRET_FOR_JWT
COOKIE_SECRET=STAGING_64_CHAR_HEX_RANDOM_SECRET_FOR_COOKIES
DOCUMENT_VAULT_ENCRYPTION_KEY=STAGING_32_BYTE_HEX_KEY_FOR_AES_256_GCM
DOCUMENT_HMAC_SECRET=STAGING_64_CHAR_HEX_SECRET_FOR_HMAC_TOKENS

# Metabase Staging Database
METABASE_DB_USER=metabase_staging
METABASE_DB_PASS=STAGING_METABASE_POSTGRES_PASSWORD

# AI Assistant Providers
GEMINI_API_KEY=YOUR_STAGING_GEMINI_API_KEY
OPENAI_API_KEY=YOUR_STAGING_OPENAI_API_KEY

LOG_LEVEL=debug
ENABLE_TELEMETRY=true
