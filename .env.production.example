# ==============================================================================
# OUTVIER PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://outvier.com

# Database Connection (Encrypted TLS with Authentication)
MONGO_URI=mongodb://outvier_admin:SECURE_STRONG_PROD_PASSWORD@127.0.0.1:27017/outvier?authSource=admin&ssl=false&replicaSet=rs0
MONGO_ROOT_USER=outvier_admin
MONGO_ROOT_PASSWORD=SECURE_STRONG_PROD_PASSWORD

# Redis Cache & Background Queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=SECURE_STRONG_REDIS_PASSWORD

# Security & Secrets (Must be 32+ characters random hex strings)
JWT_SECRET=GENERATE_64_CHAR_HEX_RANDOM_SECRET_FOR_JWT
COOKIE_SECRET=GENERATE_64_CHAR_HEX_RANDOM_SECRET_FOR_COOKIES
DOCUMENT_VAULT_ENCRYPTION_KEY=GENERATE_32_BYTE_HEX_KEY_FOR_AES_256_GCM
DOCUMENT_HMAC_SECRET=GENERATE_64_CHAR_HEX_SECRET_FOR_HMAC_TOKENS

# Metabase Application Database
METABASE_DB_USER=metabase_prod
METABASE_DB_PASS=SECURE_METABASE_POSTGRES_PASSWORD

# AI Assistant Providers (Enterprise Quotas)
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY
OPENAI_API_KEY=YOUR_PRODUCTION_OPENAI_API_KEY

# Observability & Monitoring
LOG_LEVEL=info
ENABLE_TELEMETRY=true
METRICS_PORT=9090
